{{#if resume.references.length}}
  <div class="container references-container">
    {{> title value="References"}}

    {{#each resume.references}}
      <section class="item">
        {{#if reference}}
          <div class="quote">
            <i class="fa fa-quote-left" aria-hidden="true"></i>
            <blockquote>
              {{reference}}
            </blockquote>
          </div>
        {{/if}}

        {{#if name}}
          <h4> — {{name}}</h4>
        {{/if}}
      </section>
    {{/each}}
  </div>
{{/if}}
