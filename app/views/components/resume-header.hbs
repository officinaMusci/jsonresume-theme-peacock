{{#resume.basics}}
  <header class="resume-header">
    <div class="profile-header">
      <h1 class="name">{{name}}</h1>
      <h2 class="label">{{label}}</h2>
    </div>
    <div class="profile-pic">
      {{#if image}}
        <img src="{{image}}" alt="Profile picture">
      {{/if}}
    </div>
  </header>
{{/resume.basics}}
